PORT=3000
NODE_ENV=development

# Example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/express_starter
DATABASE_URL=postgres://postgres:admin@localhost:5432/bex

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

AUTH_RATE_LIMIT_WINDOW_MS=60000 #900000
AUTH_RATE_LIMIT_MAX=5
#default-nya 5 percobaan per 15 menit per IP dan endpoint.